# Dedicated QA cloud resources only. Copy to .env.qa; never commit that file.
# MasterOne reads these exact names. Do not point at production.
APP_ENV=test
MDM_DATABASE_PROFILE=neon
MDM_DATABASE_URL=postgresql+psycopg://QA_USER:QA_PASSWORD@QA_HOST/QA_DATABASE?sslmode=require
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_QA_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_QA_R2_SECRET_ACCESS_KEY
R2_BUCKET=YOUR_DEDICATED_QA_BUCKET

# Optional summary cache; use a private bucket and a prefix lifecycle rule.
PAIR_CACHE_R2_ENDPOINT_URL=
PAIR_CACHE_R2_ACCESS_KEY_ID=
PAIR_CACHE_R2_SECRET_ACCESS_KEY=
PAIR_CACHE_R2_BUCKET=
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
AUTH_CSRF_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Optional. Keep disabled until a small canary budget is explicitly confirmed.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=0
GEMINI_MAX_OUTPUT_TOKENS=512
LLM_ENABLED=false
LLM_SEMANTIC_ENABLED=false
LLM_EXPLANATION_ENABLED=false
SEMANTIC_ADDRESS_ENABLED=false
LLM_MAX_SEMANTIC_CALLS_PER_RUN=2
LLM_MAX_EXPLANATION_CALLS_PER_RUN=2
LLM_MAX_CONCURRENCY=1
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS_SEMANTIC=250
LLM_MAX_OUTPUT_TOKENS_EXPLANATION=250
SEMANTIC_ADDRESS_MAX_PAIRS_PER_RUN=2

# OpenRouter embeddings are independent of Gemini and the chat fallback key.
# Supply this key before enabling the advanced agents and creating a NEW profile/run.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_OPENROUTER_API_KEY=
EMBEDDING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1
EMBEDDING_MAX_REQUESTS_PER_RUN=512
EMBEDDING_MAX_TOKENS_PER_RUN=2000000
EMBEDDING_BUDGET_USD=0.20
EMBEDDING_USD_PER_MILLION_TOKENS=0.02
EMBEDDING_WORKER_RSS_BYTES=1610612736
ADVANCED_MATCHING_CANDIDATE_CAP=500000
ADVANCED_MATCHING_RULE_WORKERS=1
SESSION_WORKFLOW_ENABLED=true
ENTITY_STRUCTURE_ENABLED=true
MATCHING_PROFILE_REGISTRY_ENABLED=true
ADVANCED_MATCHING_AGENTS_ENABLED=false
ADVANCED_MATCHING_INTEGRATION_ENABLED=false
PAIR_ASSESSMENT_AUTO_ENABLED=true
PAIR_REVIEW_MODEL_PATH=/app/data/models/pair-review-v2/manifest.json
PAIR_AUTOMATION_ENABLED=false
LLM_ALLOW_AUTO_MERGE_EVIDENCE=false
SAMPLE_CHAT_ENABLED=false
HEAVY_JOBS_SERIALIZED=true
HEAVY_JOB_LOCK_PATH=./data/work/heavy-job.lock
IMPORT_JOBS_CONCURRENCY=1
UPLOAD_DOWNLOAD_WORKERS=1
# Suggested Gemini MVP caps (override the smaller canary caps above when validated):
# LLM_MAX_PAIR_ASSESSMENT_CALLS_PER_RUN=100
# LLM_MAX_EXPLANATION_CALLS_PER_RUN=20
# SEMANTIC_ADDRESS_MAX_PAIRS_PER_RUN=20
AI_API_ONLY=true
