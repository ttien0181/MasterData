APP_ENV=development
APP_PORT=8001
CORS_ORIGINS=http://localhost:3000
# Select which database the backend uses. Restart the backend after changing this.
MDM_DATABASE_PROFILE=local
# Used by the cloud profile. Put your hosted PostgreSQL URL here; keep credentials private.
MDM_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Used by the local profile. Create this database/user in your local PostgreSQL first.
MDM_DATABASE_URL_LOCAL=postgresql+psycopg://masterone:YOUR_LOCAL_PASSWORD@localhost:5432/masterone
POSTGRES_DB=masterone
POSTGRES_USER=masterone
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
WORK_DIR=./data/work
REDIS_URL=
REDIS_PROGRESS_TTL_SECONDS=86400
STORAGE_CODE_VERSION=mdm-storage-v1
AUTH_CSRF_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter — LLM integration (Phase L0)
# Lấy API key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings have their own credentials/settings; Gemini/chat keys are not used.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_OPENROUTER_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_REQUESTS_PER_RUN=512
EMBEDDING_MAX_TOKENS_PER_RUN=2000000
EMBEDDING_BUDGET_USD=0.20
EMBEDDING_USD_PER_MILLION_TOKENS=0.02
PAIR_AUTOMATION_ENABLED=false
SAMPLE_CHAT_ENABLED=false

LLM_ENABLED=false
LLM_SEMANTIC_ENABLED=false
LLM_EXPLANATION_ENABLED=false

LLM_SEMANTIC_MODEL=openai/gpt-5.6-luna
LLM_EXPLANATION_MODEL=openai/gpt-5.4-nano

LLM_SEMANTIC_BATCH_SIZE=10
LLM_MAX_CONCURRENCY=5
LLM_REQUEST_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=2

LLM_CACHE_TTL_SECONDS=604800
LLM_ALLOW_AUTO_MERGE_EVIDENCE=false

LLM_MAX_SEMANTIC_CALLS_PER_RUN=2000
LLM_MAX_EXPLANATION_CALLS_PER_RUN=500
LLM_MAX_INPUT_TOKENS_PER_REQUEST=8000
LLM_MAX_OUTPUT_TOKENS_SEMANTIC=500
LLM_MAX_OUTPUT_TOKENS_EXPLANATION=500
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: browser-reachable S3 API endpoint when server/browser endpoints differ.
# Leave empty for standard Cloudflare R2. This is not an anonymous public bucket URL.
R2_PRESIGN_ENDPOINT_URL=
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket

# Optional persistent classification summary cache. Separate from source storage.
# Leave all four empty to use the bounded in-process cache only.
PAIR_CACHE_R2_ENDPOINT_URL=
PAIR_CACHE_R2_ACCESS_KEY_ID=
PAIR_CACHE_R2_SECRET_ACCESS_KEY=
PAIR_CACHE_R2_BUCKET=
SEMANTIC_ADDRESS_ENABLED=false
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_RETRIES=1
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
SEMANTIC_ADDRESS_MAX_PAIRS_PER_RUN=100
SEMANTIC_ADDRESS_TIMEOUT_SECONDS=15

# Export resource budgets; 0 disables the process-lifetime peak RSS guard.
EXPORT_BATCH_ROWS=512
EXPORT_MAX_GROUP_RECORDS=2048
EXPORT_DISK_BYTES=2147483648
EXPORT_MAX_RSS_BYTES=0
EXPORT_TIMEOUT_SECONDS=3600
EXPORT_ARTIFACT_DIR=./data/export-artifacts
EXPORT_PARQUET_ENABLED=false
# Set true to forbid local E5/Splink inference; Compose enforces true.
AI_API_ONLY=false
# Opt-in for NEW runs; existing run engine selections keep their pinned setting.
CANDIDATE_RECALL_V2=false
