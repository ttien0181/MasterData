# Copy to .env.production. This file contains no usable credentials.
# APP_DOMAIN is a hostname only, without https:// or a trailing slash.
APP_DOMAIN=masterone.example.com
ACME_EMAIL=owner@example.com
# Use a random hex password to keep the database URL valid without URL escaping.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
AUTH_CSRF_SECRET=REPLACE_WITH_RANDOM_HEX_AT_LEAST_32_CHARACTERS
APP_ENV=production

# Integrated product demo + the regular upload workflow.
DEMO_ENABLED=true
WORKFLOW_AUTO_PROCESS=true
DEMO_FAST_MODE=false
DEMO_MAX_ACTIVE_SESSIONS=12
DEMO_SESSION_SECONDS=7200
DEMO_IDLE_SECONDS=3600
SESSION_WORKFLOW_ENABLED=true
ENTITY_STRUCTURE_ENABLED=true
MATCHING_PROFILE_REGISTRY_ENABLED=true
ADVANCED_MATCHING_AGENTS_ENABLED=true
ADVANCED_MATCHING_INTEGRATION_ENABLED=true
AI_API_ONLY=true

# Real embeddings; independent from the explanation provider/key.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_OPENROUTER_API_KEY=
EMBEDDING_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_REQUESTS_PER_RUN=512
EMBEDDING_MAX_TOKENS_PER_RUN=2000000
EMBEDDING_BUDGET_USD=0.20

# Keep the values approved for your provider account; do not invent approval/prices.
# Configure Gemini or OpenRouter (or both) and add exact model IDs to the allowlist.
LLM_ENABLED=true
LLM_EXPLANATION_ENABLED=true
LLM_APPROVED_PROVIDERS=
LLM_APPROVED_MODELS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RETENTION_VERIFIED=false
GEMINI_RETENTION_CONTRACT=
GEMINI_TOKEN_PRICE_MICROUSD=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_RETENTION_VERIFIED=false
OPENROUTER_RETENTION_CONTRACT=
OPENROUTER_TOKEN_PRICE_MICROUSD=0
LLM_MAX_EXPLANATION_CALLS_PER_RUN=20
LLM_GLOBAL_CALL_CAP=1000
LLM_USER_CALL_CAP=100
LLM_TOKEN_CAP=5000000
LLM_COST_CAP_MICROUSD=10000000
LLM_MAX_CONCURRENCY=1
PAIR_AUTOMATION_ENABLED=false
LLM_ALLOW_AUTO_MERGE_EVIDENCE=false
PAIR_ASSESSMENT_AUTO_ENABLED=false
SAMPLE_CHAT_ENABLED=false

# Share local artifacts through app_data on one host; demo never writes to R2.
# R2 is optional for normal uploads. Leave all four empty to use local storage.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
HEAVY_JOBS_SERIALIZED=true
ADVANCED_MATCHING_RULE_WORKERS=1
MDM_SCORE_WORKERS=1
IMPORT_JOBS_CONCURRENCY=1
UPLOAD_DOWNLOAD_WORKERS=1
STREAM_CONSUMER_WORKERS=1
STREAM_UPLOAD_WORKERS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
